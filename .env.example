LSS_HOST=0.0.0.0
LSS_PORT=8000
LSS_LOG_LEVEL=INFO
LSS_PUBLIC_HTTP_BASE_URL=http://localhost:8000
LSS_PUBLIC_WS_BASE_URL=ws://localhost:8000
LSS_CORS_ALLOWED_ORIGINS=http://localhost:8590,http://127.0.0.1:8590
LSS_DEFAULT_TRANSCRIPTION_MODEL=small
LSS_TRANSCRIPTION_DEVICE=cpu
LSS_TRANSCRIPTION_COMPUTE_TYPE=int8
LSS_TRANSCRIPTION_BEAM_SIZE=1
LSS_TRANSCRIPTION_CONDITION_ON_PREVIOUS_TEXT=false
LSS_TRANSCRIPTION_VAD_FILTER=true
LSS_TRANSCRIPTION_LANGUAGE_LOCK_MIN_PROBABILITY=0.8
LSS_WHISPER_DOWNLOAD_ROOT=.cache/whisper
LSS_SAMPLE_RATE=16000
LSS_CHUNK_SECONDS=4.0
LSS_OVERLAP_SECONDS=0.75
LSS_MAX_SEGMENTS_PER_STREAM=500
LSS_CHUNK_QUEUE_SIZE=4
LSS_SUBSCRIBER_QUEUE_SIZE=50
